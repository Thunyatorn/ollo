# Local demo defaults. Copy to .env; npm start loads it.
# Leave provider credentials blank to keep calling simulated.
CALLS_ENABLED=false
# twilio (keypad 1/2) or cartesia_agent (spoken "I'm on it"); see docs/CARTESIA_AGENT.md
CALL_PROVIDER=twilio
CALL_ALLOWLIST=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_CALLBACK_BASE_URL=

# Ask the Cartesia booth for API credits. Confirm model and voice in your account.
CARTESIA_API_KEY=
CARTESIA_MODEL_ID=
CARTESIA_VERSION=2026-08-14
CARTESIA_VOICE_ID=
# Voice agent calls (CALL_PROVIDER=cartesia_agent)
CARTESIA_AGENT_ID=
CARTESIA_FROM_NUMBER_ID=
VOICE_WEBHOOK_SECRET=

# Telegram message (with the head-blurred key frame) at each escalation step, armed or not; labeled "simulation" when
# calls are not armed. Create the bot with @BotFather, press Start on it from each phone, and list the chat ids here
# (comma-separated). Both are needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude second opinion: opt-in in dashboard settings. Runs only after a local
# alert, on up to 4 face-blurred crops of the flagged person (~1,000 input and
# ~300 output tokens). Estimated cost per review: claude-haiku-5-5 ~$0.0003,
# claude-sonnet-5-5 ~$0.005, claude-opus-5-5 ~$0.01, claude-fable-5-1 ~$0.025.
# Use a current model ID; older models reject the effort setting.
ANTHROPIC_API_KEY=
VISION_MODEL=
MAX_MODEL_REQUESTS_PER_SESSION=200
# Plain-language rule drafting (low volume, about $0.005 per draft on Opus 5.5).
CLAUDE_MODEL=claude-opus-5-5

# Optional fixed local session secret; otherwise generated at server startup.
APP_SESSION_SECRET=
# DATA_DIR=/absolute/path/to/local/lookout-data
# APP_ORIGIN=http://127.0.0.1:5173
