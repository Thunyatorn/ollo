# Copy to worker/.env (git-ignored) and export before starting:  set -a; . ./.env; set +a
# The worker is the ONLY component that holds these keys.

# Spacetime
STDB_HTTP=http://127.0.0.1:3000
STDB_DB=nestwatch-test
# WORKER_TOKEN_FILE=.worker-token          # default; created by scripts/make_identity.py

# HTTP
WORKER_HOST=127.0.0.1                      # 0.0.0.0 to let phones on the network reach /rules/interpret
WORKER_PORT=8787
# APP_ORIGINS=https://nestwatch.example.com   # extra browser origins for the dashboard (local network is always allowed)

# Claude (second opinions, rule drafts, reports). Without a key: plain reports and keyword rule matching.
ANTHROPIC_API_KEY=
# CLAUDE_FAST_MODEL=claude-haiku-4-5       # second opinion, 5 s limit
# CLAUDE_STRONG_MODEL=claude-opus-5-5      # rules, reports, daily summary
CLOSING_TIME=18:00                         # local time of the daily summary

# Calls. Simulated unless CALLS_ENABLED=true AND every value below is set.
CALLS_ENABLED=false
CALL_PROVIDER=twilio                       # twilio (press 1) or cartesia_agent (the backup says "I'm on it"; falls back to twilio)
SIM_CALL_OUTCOME=no_answer                 # simulated calls: no_answer | press1 | error
SIM_RING_S=6
PUBLIC_BASE_URL=                           # https address Twilio can reach (a tunnel to this worker)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# CARTESIA_MODEL_ID=sonic-3.6
# CARTESIA_VERSION=2026-08-14

# Cartesia voice agent (CALL_PROVIDER=cartesia_agent). Set the agent up once as in docs/CARTESIA_AGENT.md of the team build;
# its tool `acknowledge_alert` posts {token, decision} to PUBLIC_BASE_URL/webhooks/voice/ack with this bearer secret.
CARTESIA_AGENT_ID=
CARTESIA_FROM_NUMBER_ID=
VOICE_WEBHOOK_SECRET=

# Telegram alert messages with the key frame (free; replaces the SMS text when set). Create the bot with @BotFather, then
# press Start on it from each phone that should get alerts.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=                        # optional, comma-separated; default: everyone who pressed Start
