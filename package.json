{
  "name": "lookout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:ui": "node scripts/smoke.mjs",
    "test:media": "node scripts/media-smoke.mjs",
    "format": "prettier --write src scripts index.html vite.config.ts package.json tsconfig.json",
    "models": ".venv/bin/python -m server.fetch_models",
    "test:design": "node scripts/design-smoke.mjs",
    "test:camera": "node scripts/camera-smoke.mjs",
    "test:webcam": "node scripts/webcam-smoke.mjs",
    "test:skeleton": "node scripts/skeleton-smoke.mjs",
    "test:catchup": "node scripts/catchup-smoke.mjs",
    "eval": ".venv/bin/python -m server.evaluate",
    "test:threads": "node --test scripts/incident-threads.test.mjs scripts/timecode.test.mjs",
    "test:threads:ui": "node scripts/incident-threads-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wavesurfer.js": "^8.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "agentation": "^3.1.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
